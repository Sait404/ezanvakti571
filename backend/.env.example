# EzanVakti571 backend — örnek ortam değişkenleri. Gerçek değerleri .env dosyasına yazın; .env Git'e girmez.
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# İzin verilen istemci kaynakları (virgülle). Mobil uygulama CORS gerektirmez; web için doldurun.
CORS_ORIGINS=

# Diyanet İşleri Başkanlığı Awqat Salah API erişimi (Diyanet'ten başvuru ile alınır).
# Boş bırakılırsa /v1/prayer-times 503 döner ve uygulama cihazda hesaplamaya düşer.
DIYANET_BASE_URL=https://awqatsalah.diyanet.gov.tr
DIYANET_EMAIL=
DIYANET_PASSWORD=
# il/ilçe → Diyanet şehir kimliği eşlemesi (npm run sync:diyanet-places ile üretilir)
DIYANET_PLACE_MAP=./data/diyanet-place-map.json

# PostgreSQL (kullanıcı hesabı/bulut özellikleri için; bu sürümde vakit servisi DB gerektirmez)
DATABASE_URL=postgres://ezanvakti571:CHANGE_ME@localhost:5432/ezanvakti571

# Hız sınırı: IP başına dakikada istek
RATE_LIMIT_PER_MINUTE=60
